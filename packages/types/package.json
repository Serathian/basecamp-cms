{
  "name": "@basecamp-cms/basecamp-cms-types",
  "version": "1.0.0",
  "description": "TypeScript types generated from basecamp-cms Payload CMS config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serathian/basecamp-cms.git",
    "directory": "packages/types"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').cpSync('../../src/payload-types-export.ts', './payload-types.ts')\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').rmSync('./payload-types.ts', {force: true})\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
