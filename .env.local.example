# Database — matches docker-compose.yml defaults
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# Payload secret — must be at least 32 characters
PAYLOAD_SECRET=dev-secret-must-be-at-least-32-chars-long

# Server URL — used for self-referencing (e.g. GPX file fetch in hooks)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
